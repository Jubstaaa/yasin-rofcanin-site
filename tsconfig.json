{
    "extends": "@jubstaaa/config/tsconfig/next",
    "compilerOptions": {
        "target": "ES2017",
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
